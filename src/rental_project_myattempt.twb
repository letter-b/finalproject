    <worksheet name='Rental Eligible by Category'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Which products are rental-eligible (12+ months unsold)?</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='categories+' name='federated.06hi1mg02r47ry1ej9bra19yix9c' />
