            <column caption='Days on Shelf' datatype='integer' name='[Calculation_1990998241239040]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [listed_date], #2024-12-31#)' />
            </column>
            <column caption='Is Rental Eligible' datatype='integer' name='[Calculation_1990998241415169]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_1990998241239040] &gt;= 365 THEN 1 ELSE 0 END' />
            </column>
